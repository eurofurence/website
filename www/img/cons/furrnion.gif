            <script>
 var url=document.querySelectorAll("[hreflang=es]");
var url_corregida=url[0].href;
for (var k=1;k<3;k++){
url[k].href=url_corregida;
}

//corregir enlace de idioma

var actual = window.location.href;

if(actual.indexOf("/entrada")>0 || actual.indexOf("/tienda")>0  || actual.indexOf("/upgrades")>0 || 
actual.indexOf("/ticket")>0 ||
actual.indexOf("/dealers-den-pago")>0 ||
actual.indexOf("/dealers-den-payment")>0 ||
actual.indexOf("/mejoras")>0
){

 var url_en=document.querySelectorAll("[hreflang=en]");
var url_en_corregida = url_en[0].href;
url_en[1].href=url_en_corregida;
url_en[2].href=url_en_corregida;
}

// corregir carrito:

var data=document.getElementsByClassName("header-language-dropdown");

var idioma=data[0].innerHTML.substring(14,26);

if(idioma.indexOf("Espa")>0){
 document.getElementsByClassName("header-cart-link")[0].href="https://furrnion.org/cart/";
}

var prev = document.referrer;
var act = window.location.href;
console.log(prev);
if(prev.indexOf("checkout_en")>0){
var pcen = act.replace("checkout","en/checkout-en");
window.location.href=pcen;
}
</script>          </div>
